{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/domain/*": ["src/domain/*"],
      "@/interpretation/*": ["src/domain/interpretation/*"],
      "@/professional/*": ["src/domain/professional/*"],
      "@/domain/device": ["src/domain/device/index.ts"],
      "@/domain/device/*": ["src/domain/device/*"],
      "@/assets/*": ["apps/mobile/assets/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "apps/mobile/app/**/*.ts",
    "apps/mobile/app/**/*.tsx",
    "packages/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["apps/web/**"]
}
