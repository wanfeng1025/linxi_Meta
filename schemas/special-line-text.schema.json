{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "$ref": "#/$defs/__schema0" },
    "contentLayer": { "$ref": "#/$defs/__schema1" },
    "sourceId": { "$ref": "#/$defs/__schema0" },
    "sourceVersion": { "$ref": "#/$defs/__schema2" },
    "contentVersion": { "$ref": "#/$defs/__schema2" },
    "status": { "$ref": "#/$defs/__schema3" },
    "sourceLocator": { "$ref": "#/$defs/__schema4" },
    "originalScript": { "$ref": "#/$defs/__schema5" },
    "normalizationNotes": { "$ref": "#/$defs/__schema6" },
    "editorialChanges": { "$ref": "#/$defs/__schema7" },
    "verifiedBy": { "$ref": "#/$defs/__schema8" },
    "verifiedAt": { "$ref": "#/$defs/__schema9" },
    "checksum": { "$ref": "#/$defs/__schema10" },
    "rulesetId": { "$ref": "#/$defs/__schema0" },
    "rulesetVersion": { "$ref": "#/$defs/__schema2" },
    "hexagramId": { "$ref": "#/$defs/__schema0" },
    "kind": { "$ref": "#/$defs/__schema11" },
    "trigger": { "$ref": "#/$defs/__schema12" }
  },
  "required": [
    "id",
    "contentLayer",
    "sourceId",
    "sourceVersion",
    "contentVersion",
    "status",
    "sourceLocator",
    "originalScript",
    "normalizationNotes",
    "editorialChanges",
    "verifiedBy",
    "verifiedAt",
    "checksum",
    "rulesetId",
    "rulesetVersion",
    "hexagramId",
    "kind",
    "trigger"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "__schema1": { "type": "string", "const": "classical" },
    "__schema2": { "type": "string", "minLength": 1 },
    "__schema3": { "type": "string", "enum": ["draft", "verified"] },
    "__schema4": { "type": "string", "minLength": 1 },
    "__schema5": {
      "type": "string",
      "enum": ["simplified", "traditional", "mixed", "not-applicable"]
    },
    "__schema6": { "type": "string" },
    "__schema7": { "type": "string" },
    "__schema8": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "__schema9": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        { "type": "null" }
      ]
    },
    "__schema10": {
      "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
    },
    "__schema11": { "type": "string", "enum": ["use-nine", "use-six"] },
    "__schema12": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "all-six-lines-equal" },
        "lineValue": {
          "anyOf": [
            { "type": "number", "const": 6 },
            { "type": "number", "const": 9 }
          ]
        }
      },
      "required": ["type", "lineValue"],
      "additionalProperties": false
    }
  },
  "$id": "https://liuyao.app/schemas/special-line-text.schema.json",
  "$comment": "Generated from scripts/content-data-schema.ts. Cross-record and release-gate rules are enforced by validateContentDataset."
}
