        "sourceVersion",
        "sourceLocator",
        "revision",
        "sourceSha256",
        "verificationStatus"
      ],
      "additionalProperties": false
    },
    "entries": {
      "minItems": 64,
      "maxItems": 64,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    }
  },
  "required": ["schemaVersion", "source", "entries"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "hexagramId": { "type": "string", "minLength": 1 },
        "kingWenSequence": { "type": "integer", "minimum": 1, "maximum": 64 },
        "name": { "type": "string", "minLength": 1 },
        "unicodeSymbol": { "type": "string", "minLength": 1 },
        "upperTrigramId": { "type": "string", "minLength": 1 },
        "lowerTrigramId": { "type": "string", "minLength": 1 }
      },
      "required": [
        "hexagramId",
        "kingWenSequence",
        "name",
        "unicodeSymbol",
        "upperTrigramId",
        "lowerTrigramId"
      ],
      "additionalProperties": false
    }
