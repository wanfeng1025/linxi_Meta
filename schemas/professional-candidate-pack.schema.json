{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "professional-candidate-v1" },
    "source": {
      "type": "object",
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "sourceLocator": { "type": "string", "minLength": 1 },
        "revision": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verificationStatus": {
          "type": "string",
          "enum": ["production_candidate", "editorial_original"]
        }
      },
      "required": [
        "sourceId",
        "sourceVersion",
        "sourceLocator",
        "revision",
        "sourceSha256",
        "verificationStatus"
      ],
      "additionalProperties": false
    },
    "ruleset": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "const": "jingfang-yehe-baseline" },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "version"],
      "additionalProperties": false
