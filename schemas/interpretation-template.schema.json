{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "$ref": "#/$defs/__schema0" },
    "contentLayer": { "$ref": "#/$defs/__schema1" },
    "sourceId": { "$ref": "#/$defs/__schema0" },
    "sourceVersion": { "$ref": "#/$defs/__schema2" },
    "contentVersion": { "$ref": "#/$defs/__schema2" },
    "status": { "$ref": "#/$defs/__schema3" },
    "sourceLocator": { "$ref": "#/$defs/__schema4" },
    "originalScript": { "$ref": "#/$defs/__schema5" },
    "normalizationNotes": { "$ref": "#/$defs/__schema6" },
    "editorialChanges": { "$ref": "#/$defs/__schema7" },
    "verifiedBy": { "$ref": "#/$defs/__schema8" },
    "verifiedAt": { "$ref": "#/$defs/__schema9" },
    "checksum": { "$ref": "#/$defs/__schema10" },
    "categoryId": { "$ref": "#/$defs/__schema11" },
    "templateKey": { "$ref": "#/$defs/__schema0" },
    "templateVersion": { "$ref": "#/$defs/__schema2" },
    "locale": { "$ref": "#/$defs/__schema12" },
    "outputLevel": { "$ref": "#/$defs/__schema13" },
    "primarySymbol": { "$ref": "#/$defs/__schema14" },
    "trend": { "$ref": "#/$defs/__schema15" },
    "rulesetId": { "$ref": "#/$defs/__schema16" },
    "rulesetVersion": { "$ref": "#/$defs/__schema17" },
    "templateText": { "$ref": "#/$defs/__schema18" },
    "variables": { "$ref": "#/$defs/__schema19" },
    "safetyTags": { "$ref": "#/$defs/__schema20" }
  },
  "required": [
    "id",
    "contentLayer",
    "sourceId",
    "sourceVersion",
    "contentVersion",
    "status",
    "sourceLocator",
    "originalScript",
    "normalizationNotes",
    "editorialChanges",
    "verifiedBy",
    "verifiedAt",
    "checksum",
    "categoryId",
    "templateKey",
    "templateVersion",
    "locale",
    "outputLevel",
    "primarySymbol",
    "trend",
    "rulesetId",
    "rulesetVersion",
    "templateText",
    "variables",
    "safetyTags"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "__schema1": { "type": "string", "const": "product" },
    "__schema2": { "type": "string", "minLength": 1 },
    "__schema3": { "type": "string", "enum": ["draft", "verified"] },
    "__schema4": { "type": "string", "minLength": 1 },
    "__schema5": {
      "type": "string",
      "enum": ["simplified", "traditional", "mixed", "not-applicable"]
    },
    "__schema6": { "type": "string" },
    "__schema7": { "type": "string" },
    "__schema8": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "__schema9": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        { "type": "null" }
      ]
    },
    "__schema10": {
      "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
    },
    "__schema11": { "anyOf": [{ "$ref": "#/$defs/__schema0" }, { "type": "null" }] },
    "__schema12": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$" },
    "__schema13": { "type": "string", "enum": ["summary", "standard", "detailed"] },
    "__schema14": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "auspicious",
            "inauspicious",
            "remorse",
            "regret",
            "danger",
            "blameless",
            "undetermined"
          ]
        },
        { "type": "null" }
      ]
    },
    "__schema15": {
      "anyOf": [
        { "type": "string", "enum": ["rising", "falling", "stable", "turning", "undetermined"] },
        { "type": "null" }
      ]
    },
    "__schema16": { "anyOf": [{ "$ref": "#/$defs/__schema0" }, { "type": "null" }] },
    "__schema17": { "anyOf": [{ "$ref": "#/$defs/__schema2" }, { "type": "null" }] },
    "__schema18": { "type": "string", "minLength": 1 },
    "__schema19": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "factPath": { "type": "string", "pattern": "^[a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*$" }
        },
        "required": ["name", "factPath"],
        "additionalProperties": false
      }
    },
    "__schema20": { "readOnly": true, "type": "array", "items": { "$ref": "#/$defs/__schema0" } }
  },
  "$id": "https://liuyao.app/schemas/interpretation-template.schema.json",
  "$comment": "Generated from scripts/content-data-schema.ts. Cross-record and release-gate rules are enforced by validateContentDataset."
}
