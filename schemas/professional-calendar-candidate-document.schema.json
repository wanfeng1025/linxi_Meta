        "policyId",
        "calendarAlgorithmVersion",
        "solarTermDataVersion",
        "timezoneDataVersion",
        "sourceIds",
        "dayGanzhiAnchor",
        "coverageEndInclusiveInstant",
        "solarTerms",
        "timezones"
