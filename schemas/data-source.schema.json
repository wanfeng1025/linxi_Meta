    "dynastyOrYear": { "$ref": "#/$defs/__schema4" },
    "edition": { "$ref": "#/$defs/__schema5" },
    "publisherOrPlatform": { "$ref": "#/$defs/__schema6" },
    "locator": { "$ref": "#/$defs/__schema7" },
    "sourceType": { "$ref": "#/$defs/__schema8" },
    "url": { "$ref": "#/$defs/__schema9" },
    "licenseStatus": { "$ref": "#/$defs/__schema10" },
    "publicDomainStatus": { "$ref": "#/$defs/__schema11" },
    "transcriptionStatus": { "$ref": "#/$defs/__schema12" },
    "proofreadingStatus": { "$ref": "#/$defs/__schema13" },
    "accessedAt": { "$ref": "#/$defs/__schema14" },
    "reliabilityGrade": { "$ref": "#/$defs/__schema16" },
