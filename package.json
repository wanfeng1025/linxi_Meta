{
  "name": "liuyao-system",
  "version": "0.1.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "pnpm --filter @liuyao/mobile start",
    "start:go": "pnpm --filter @liuyao/mobile start:go",
    "android": "pnpm --filter @liuyao/mobile android",
    "ios": "pnpm --filter @liuyao/mobile ios",
    "mobile:web": "pnpm --filter @liuyao/mobile web",
    "dev:web": "pnpm --filter @liuyao/web dev",
    "build:web": "pnpm --filter @liuyao/web build",
    "typecheck": "pnpm --filter @liuyao/mobile exec tsc --noEmit && pnpm --filter @liuyao/web run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:web:e2e": "pnpm --filter @liuyao/web run test:e2e",
    "build:content-seed": "tsx scripts/build-content-seed.ts",
    "build:content-source": "tsx scripts/build-content-source-from-catalog.ts",
    "build:classical-quotes": "tsx scripts/import-authorized-classical-quotes.ts",
    "build:authorized-interpretations": "tsx scripts/import-authorized-hexagram-line-interpretations.ts",
    "build:draft-interpretations": "tsx scripts/import-draft-hexagram-line-explanations.ts",
    "build:m4-candidates": "tsx scripts/build-m4-a-candidate-pack.ts",
    "validate:m4-candidates": "tsx scripts/validate-m4-candidates.ts",
    "check:content-source": "tsx scripts/build-content-source-from-catalog.ts --check",
    "check:classical-quotes": "tsx scripts/import-authorized-classical-quotes.ts --check",
    "check:authorized-interpretations": "tsx scripts/import-authorized-hexagram-line-interpretations.ts --check",
    "check:draft-interpretations": "tsx scripts/import-draft-hexagram-line-explanations.ts --check",
    "build:content-schemas": "tsx scripts/build-content-json-schemas.ts",
    "check:content-schemas": "tsx scripts/build-content-json-schemas.ts --check",
    "build:professional-candidate": "tsx scripts/build-professional-candidate.ts",
    "check:professional-candidate": "tsx scripts/build-professional-candidate.ts --check",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:content-schemas && pnpm run check:content-source && pnpm run check:classical-quotes && pnpm run check:authorized-interpretations && pnpm run check:draft-interpretations && pnpm run test && pnpm run validate:data && pnpm run validate:m4-candidates"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  }
}
