    {
      "id": "candidate-text-028",
      "hexagramId": "hexagram-kw-02",
      "linePosition": 2,
      "textKind": "line_image",
      "text": "象曰：六二之動，直以方也。不習無不利，地道光也。",
      "source": {
        "sourceId": "module-four-acceptance-pack",
        "sourceVersion": "2026-07-25-candidate-v1",
        "sourceLocator": "六爻App模块四内容数据库缺失数据补全与生产验收包.txt",
        "revision": null,
        "sourceSha256": "537d3ec190263166c1a3f541c962c44ce12bec47ba30b5c8cdc2a8841c8953a4",
        "verificationStatus": "production_candidate"
      }
    },
    {
      "id": "candidate-text-029",
      "hexagramId": "hexagram-kw-02",
      "linePosition": 3,
      "textKind": "line_image",
      "text": "象曰：含章可貞，以時發也。或從王事，知光大也。",
      "source": {
        "sourceId": "module-four-acceptance-pack",
        "sourceVersion": "2026-07-25-candidate-v1",
        "sourceLocator": "六爻App模块四内容数据库缺失数据补全与生产验收包.txt",
        "revision": null,
        "sourceSha256": "537d3ec190263166c1a3f541c962c44ce12bec47ba30b5c8cdc2a8841c8953a4",
        "verificationStatus": "production_candidate"
      }
    },
    {
      "id": "candidate-text-030",
      "hexagramId": "hexagram-kw-02",
      "linePosition": 4,
      "textKind": "line_image",
      "text": "象曰：括囊無咎，慎不害也。",
      "source": {
        "sourceId": "module-four-acceptance-pack",
        "sourceVersion": "2026-07-25-candidate-v1",
        "sourceLocator": "六爻App模块四内容数据库缺失数据补全与生产验收包.txt",
        "revision": null,
        "sourceSha256": "537d3ec190263166c1a3f541c962c44ce12bec47ba30b5c8cdc2a8841c8953a4",
        "verificationStatus": "production_candidate"
      }
    },
    {
      "id": "candidate-text-031",
      "hexagramId": "hexagram-kw-02",
      "linePosition": 5,
