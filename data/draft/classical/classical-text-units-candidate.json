        "verificationStatus": "production_candidate"
      }
    },
    {
      "id": "candidate-text-014",
      "hexagramId": "hexagram-kw-01",
      "linePosition": 5,
      "textKind": "line_image",
      "text": "象曰：飛龍在天，大人造也。",
      "source": {
